{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "types": ["vite/client", "node"]
    },
    "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "scripts/**/*.mjs"]
}
