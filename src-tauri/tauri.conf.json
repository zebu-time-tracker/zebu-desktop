{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Zebu",
    "version": "0.1.0",
    "identifier": "work.zebu.desktop",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Zebu",
                "width": 380,
                "height": 540,
                "visible": false,
                "decorations": false,
                "resizable": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "shadow": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "app",
            "dmg",
            "msi",
            "nsis",
            "appimage",
            "deb",
            "rpm"
        ],
        "createUpdaterArtifacts": true,
        "publisher": "Zebu",
        "homepage": "https://zebu.work",
        "category": "Productivity",
        "shortDescription": "Menubar time tracker for Zebu",
        "longDescription": "Start and stop timers, browse your week and see today's hours from the menubar, connected to your Zebu workspace.",
        "copyright": "© Alan Woo. Elastic License 2.0.",
        "licenseFile": "../LICENSE.md",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "minimumSystemVersion": "11.0",
            "hardenedRuntime": true,
            "entitlements": "Entitlements.plist",
            "dmg": {
                "appPosition": {
                    "x": 180,
                    "y": 170
                },
                "applicationFolderPosition": {
                    "x": 480,
                    "y": 170
                }
            }
        },
        "windows": {
            "webviewInstallMode": {
                "type": "downloadBootstrapper"
            },
            "nsis": {
                "installMode": "currentUser",
                "languages": [
                    "English"
                ]
            }
        },
        "linux": {
            "deb": {
                "depends": []
            },
            "appimage": {
                "bundleMediaFramework": false
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwNzUwOEE4QUEyMjZFQzkKUldUSmJpS3FxQWgxUU0yNTJRQWpQRmdGaFlza29wT2hKRVJTRlpQQ1psY2VJdmJ0TWpDN0h6L1UK",
            "endpoints": [
                "https://github.com/zebu-time-tracker/zebu-desktop/releases/latest/download/latest.json"
            ]
        }
    }
}
