{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Main window capabilities",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "core:window:allow-set-size",
        "core:window:allow-show",
        "core:window:allow-set-focus",
        "opener:default",
        "updater:default",
        "process:allow-restart"
    ]
}
